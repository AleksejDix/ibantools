{
  "name": "ibantools",
  "version": "4.5.1",
  "description": "Validation, extraction and creation of IBAN, BBAN, BIC/SWIFT numbers",
  "keywords": [
    "IBAN",
    "BBAN",
    "BIC",
    "SEPA",
    "SWIFT"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "homepage": "https://github.com/Simplify/ibantools",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simplify/ibantools.git"
  },
  "bugs": "https://github.com/Simplify/ibantools/issues",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware src/ test/",
    "format": "oxfmt src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "prepare": "npm run build",
    "docs": "typedoc src/index.ts",
    "all": "npm run test && npm run lint && npm run format:check && npm run docs"
  },
  "author": {
    "name": "Aleksej Dix",
    "email": "privat@aleksejdix.com"
  },
  "contributors": [
    {
      "name": "Saša Jovanić",
      "url": "https://www.simplify.ba/"
    }
  ],
  "license": "MIT or MPL-2.0",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
